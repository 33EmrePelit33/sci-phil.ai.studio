# Google Gemini API credentials (server-only). GOOGLE_API_KEY takes precedence if both are set.
GOOGLE_API_KEY=""
# GEMINI_API_KEY is also supported for AI Studio/older deployments.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Umami Cloud live analytics (create a website for sci-phil.ai.studio).
# Website ID is public; API key is a server-only secret and must never be added to frontend code.
UMAMI_WEBSITE_ID="YOUR_UMAMI_WEBSITE_ID"
# Optional individual site IDs to combine other properties in the public panel.
UMAMI_BLOGGER_WEBSITE_ID=""
UMAMI_GROKME_WEBSITE_ID=""
UMAMI_GITHUB_PAGES_WEBSITE_ID=""
UMAMI_GITHUB_PAGES_DOMAIN=""
# Or define/override properties with compact JSON: [{"key":"extra","name":"Other site","domain":"example.com","id":"actual-public-website-id"}]
UMAMI_WEBSITES=""
UMAMI_API_KEY="YOUR_UMAMI_API_KEY"
UMAMI_API_BASE_URL="https://api.umami.is/v1"
UMAMI_SCRIPT_URL="https://cloud.umami.is/script.js"
# Reporting milestone: visits from midnight in Türkiye on 12 October 2026 onward.
ANALYTICS_START_AT="2026-10-12T00:00:00+03:00"

HOST=0.0.0.0
PORT=3000
NODE_ENV=development